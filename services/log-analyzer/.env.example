# ClickHouse connection (port-forward example: kubectl port-forward svc/clickhouse 8123:8123 -n observability)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=observability

# Table used to persist run state
RUNS_TABLE=api_runs

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Simulated run behavior
RUN_MIN_DURATION_SECONDS=1.0
RUN_MAX_DURATION_SECONDS=8.0
RUN_FAILURE_RATE=0.1
RUN_MAX_CONCURRENCY=5
