# ClickHouse connection (port-forward example: kubectl port-forward svc/clickhouse 8123:8123 -n observability)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=observability

# Source tables
LOGS_TABLE=vector_logs
METRICS_TABLE=vector_metrics

# Service grouping column in logs table. Set AUTO to detect from ServiceName/service_name/container_name/pod_name.
SERVICE_COLUMN=AUTO

# Analyzer behavior
ANALYZER_JOB_ID=hourly-system-health
ANALYZER_INTERVAL_SECONDS=3600
ANALYZER_WINDOW_MINUTES=60
ANOMALY_ZSCORE_THRESHOLD=3.0

# Optional LLM endpoint. If unset, analyzer produces deterministic local summary.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
